{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🔨 Build (UV4)",
            "detail": "增量编译 → 日志直接输出到终端",
            "type": "shell",
            "command": "C:\\Keil_v5\\UV4\\UV4.exe -b 03-March_Wheel_leg_FOC.uvproj -j0 -t 03-March_Wheel_leg_FOC -l Objects\\build.log && type Objects\\build.log",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
            },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": {
                "owner": "c251",
                "pattern": {
                    "regexp": "^(.*)\\((\\d+)\\)\\s+(WARNING|ERROR)\\s+(C\\d+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 5
                }
            }
        },
        {
            "label": "🧹 Clean (UV4)",
            "detail": "清理构建产物 → 日志直接输出到终端",
            "type": "shell",
            "command": "C:\\Keil_v5\\UV4\\UV4.exe -c 03-March_Wheel_leg_FOC.uvproj -j0 -t 03-March_Wheel_leg_FOC -l Objects\\build.log && type Objects\\build.log",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
            },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "🔄 Rebuild (UV4)",
            "detail": "清理 + 完整重建 → 日志直接输出到终端",
            "type": "shell",
            "command": "C:\\Keil_v5\\UV4\\UV4.exe -r 03-March_Wheel_leg_FOC.uvproj -j0 -t 03-March_Wheel_leg_FOC -l Objects\\build.log && type Objects\\build.log",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
            },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": {
                "owner": "c251",
                "pattern": {
                    "regexp": "^(.*)\\((\\d+)\\)\\s+(WARNING|ERROR)\\s+(C\\d+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 5
                }
