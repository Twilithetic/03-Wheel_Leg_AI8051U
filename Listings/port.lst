   27          ////////////////////////////////////////
   28          // P3口初始化函数
   29          // 入口参数: 无
   30          // 函数返回: 无
   31          ////////////////////////////////////////
   32          void PORT3_Init(void)
   33          {
   34   1          SetP3nInitLevelHigh(PIN_ALL);       //设置P3初始化电平
   35   1          SetP3nQuasiMode(PIN_7 | PIN_6 | PIN_5 | PIN_4 | PIN_3 | PIN_2); //设置P3.7,P3.6,P3.5,P3.4,P3.3,P3.2
             -为准双向口模式
   36   1          SetP3nHighZInputMode(PIN_1 | PIN_0); //设置P3.1,P3.0为高阻输入模式
   37   1          SetP3nManualMode(PIN_ALL);          //设置P3手动配置端口模式
   38   1      
   39   1          DisableP3nPullUp(PIN_ALL);          //关闭P3内部上拉电阻
   40   1          DisableP3nPullDown(PIN_ALL);        //关闭P3内部下拉电阻
   41   1          EnableP3nSchmitt(PIN_ALL);          //使能P3施密特触发
   42   1          SetP3nSlewRateNormal(PIN_ALL);      //设置P3一般翻转速度
   43   1          SetP3nDrivingNormal(PIN_ALL);       //设置P3一般驱动能力
   44   1          SetP3nDigitalInput(PIN_ALL);        //使能P3数字信号输入功能
   45   1      
   46   1          //<<AICUBE_USER_PORT3_INITIAL_BEGIN>>
   47   1          // 在此添加用户初始化代码  
   48   1          //<<AICUBE_USER_PORT3_INITIAL_END>>
   49   1      }
