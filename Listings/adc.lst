   65          ////////////////////////////////////////
   66          // 获取ADC转换结果函数
   67          // 入口参数: ch (ADC通道选择)
   68          // 函数返回: ADC转换结果
   69          ////////////////////////////////////////
   70          uint16_t ADC_Convert(uint8_t ch)
   71          {
   72   1          uint16_t res;                       //定义保存ADC结果的变量
   73   1      
   74   1          ADC_ActiveChannel(ch);              //选择ADC通道
   75   1          ADC_Start();                        //开始ADC转换
   76   1          while (!ADC_CheckFlag());           //等待ADC转换完成
   77   1          ADC_ClearFlag();                    //清除ADC转换完成中断标志
   78   1          res = ADC_ReadResult();             //读取ADC转换结果
   79   1      
   80   1          return res;                         //返回ADC结果
   81   1      }
