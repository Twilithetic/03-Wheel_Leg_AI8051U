  169          void PORT5_Init(void)
  170          {
  171   1          SetP5nInitLevelHigh(PIN_ALL);       //设置P5初始化电平
  172   1          SetP5nQuasiMode(PIN_7 | PIN_6 | PIN_5 | PIN_4); //设置P5.7,P5.6,P5.5,P5.4为准双向口模式
  173   1          SetP5nPushPullMode(PIN_3 | PIN_2 | PIN_1 | PIN_0); //设置P5.3,P5.2,P5.1,P5.0为推挽输出模式
  174   1          SetP5nAutoMode(PIN_ALL);            //设置P5自动配置端口模式
  175   1      
  176   1          DisableP5nPullUp(PIN_ALL);          //关闭P5内部上拉电阻
  177   1          DisableP5nPullDown(PIN_ALL);        //关闭P5内部下拉电阻
  178   1          EnableP5nSchmitt(PIN_ALL);          //使能P5施密特触发
  179   1          SetP5nSlewRateFast(PIN_ALL);        //设置P5快速翻转速度
  180   1          SetP5nDrivingStrong(PIN_ALL);       //设置P5增强驱动能力
  181   1          SetP5nAnalogInput(PIN_ALL);         //使能P5模拟信号输入功能
  182   1      
