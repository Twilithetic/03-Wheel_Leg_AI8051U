   17          
   18          // ==================== T0 初始化 ====================
   19          void Timer0_Init(void)
   20          {
   21   1          // 1. 设置为模式 0（16 位自动重装载）
   22   1          TMOD &= 0xF0;              // 清除 T0 控制字段
   23   1          TMOD |= 0x00;              // GATE=0, C/T=0, M1=0, M0=0
   24   1          
   25   1          // 2. 设置重装载值（目标：10ms 中断）
   26   1          //    系统时钟 = 24MHz (默认 HIRC)
   27   1          //    TM0PS = 11 → 预分频 12 → 定时器时钟 = 2MHz
   28   1          //    65536 - 20000 = 45536 = 0xB1E0
   29   1          TL0 = 0xE0;                // 低字节先写
   30   1          TH0 = 0xB1;                // 高字节
   31   1          
   32   1          // 3. 设置 8 位预分频器（EAXFR 已在 SYS_Init 中打开，无需重复操作）
   33   1          TM0PS = 11;                // 预分频 ÷ 12
   34   1          
   35   1          // 4. 1T 模式（不分频，速度最快）
   36   1          AUXR |= 0x80;              // T0x12 = 1
   37   1          
   38   1          // 5. 开中断
   39   1          ET0 = 1;                   // 允许 T0 中断
   40   1          EA  = 1;                   // 开总中断
   41   1          
   42   1          // 6. 启动定时器
   43   1          TR0 = 1;                   // T0 开始计数
   44   1      }
   45          
   46          // ==================== T0 中断服务程序 ====================
   47          void Timer0_ISR(void) interrupt 1
   48          {
   49   1          tick_10ms++;               // 每 10ms +1
   50   1          
   51   1          if (tick_10ms >= 100)      // 1 秒到了（10ms × 100 = 1000ms）
   52   1          {
   53   2              tick_10ms = 0;
   54   2              P42 = ~P42;            // 翻转 LED（0.5s 亮, 0.5s 灭 = 1Hz 闪烁）
   55   2          }
   56   1      }
   57          //<<AICUBE_USER_GLOBAL_DEFINE_END>>
