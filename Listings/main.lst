   58          // ==================== T0 初始化 ====================
   59          void Timer0_Init(void)
   60          {
   61   1          // 1. 设置为模式 0（16 位自动重装载）
   62   1          TMOD &= 0xF0;              // 清除 T0 控制字段
   63   1          TMOD |= 0x00;              // GATE=0, C/T=0, M1=0, M0=0
   64   1          
   65   1          // 2. 设置重装载值（目标：10ms 中断）
   66   1          //    系统时钟 = 24MHz (默认 HIRC)
   67   1          //    TM0PS = 11 → 预分频 12 → 定时器时钟 = 2MHz
   68   1          //    65536 - 20000 = 45536 = 0xB1E0
   69   1          TL0 = 0xE0;                // 低字节先写
   70   1          TH0 = 0xB1;                // 高字节
   71   1          
   72   1          // 3. 设置 8 位预分频器（EAXFR 已在 SYS_Init 中打开，无需重复操作）
   73   1          TM0PS = 11;                // 预分频 ÷ 12
   74   1          
   75   1          // 4. 1T 模式（不分频，速度最快）
   76   1          AUXR |= 0x80;              // T0x12 = 1
   77   1          
   78   1          // 5. 开中断
   79   1          ET0 = 1;                   // 允许 T0 中断
   80   1          EA  = 1;                   // 开总中断
   81   1          
   82   1          // 6. 启动定时器
   83   1          TR0 = 1;                   // T0 开始计数
   84   1      }
