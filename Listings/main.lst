   27          // ==================== T0 初始化 ====================
   28          void Timer0_Init(void)
   29          {
   30   1          // 1. 设置为模式 0（16 位自动重装载）
   31   1          TMOD &= 0xF0;              // 清除 T0 控制字段
   32   1          TMOD |= 0x00;              // GATE=0, C/T=0, M1=0, M0=0
   33   1          
   34   1          // 2. 设置重装载值（目标：10ms 中断）
   35   1          //    系统时钟 = 24MHz (默认 HIRC)
   36   1          //    TM0PS = 11 → 预分频 12 → 定时器时钟 = 2MHz
   37   1          //    65536 - 20000 = 45536 = 0xB1E0
   38   1          TL0 = 0xE0;                // 低字节先写
   39   1          TH0 = 0xB1;                // 高字节
   40   1          
   41   1          // 3. 设置 8 位预分频器 (需要先访问扩展寄存器)
   42   1          EAXFR = 1;                 // 允许访问扩展 XFR
   43   1          TM0PS = 11;                // 预分频 ÷ 12
   44   1          EAXFR = 0;
   45   1          
   46   1          // 4. 1T 模式（不分频，速度最快）
   47   1          AUXR |= 0x80;              // T0x12 = 1
   48   1          
   49   1          // 5. 开中断
   50   1          ET0 = 1;                   // 允许 T0 中断
   51   1          EA  = 1;                   // 开总中断
   52   1          
   53   1          // 6. 启动定时器
   54   1          TR0 = 1;                   // T0 开始计数
   55   1      }
   56          
   57          // ==================== T0 中断服务程序 ====================
   58          void Timer0_ISR(void) interrupt 1
