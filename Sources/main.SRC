; line 21:     // 1. 设置为模式 0（16 位自动重装载）
; line 22:     TMOD &= 0xF0;              // 清除 T0 控制字段
        ANL      TMOD,#0F0H
; line 23:     TMOD |= 0x00;              // GATE=0, C/T=0, M1=0, M0=0
        MOV      A,TMOD                         ; A=R11
        MOV      TMOD,A                         ; A=R11
