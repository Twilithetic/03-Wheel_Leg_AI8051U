; line 31:     
; line 32:     // 3. 设置 8 位预分频器（EAXFR 已在 SYS_Init 中打开，无需重复操作）
; line 33:     TM0PS = 11;                // 预分频 ÷ 12
        MOV      A,#0BH                         ; A=R11
        MOV      WR6,#0FEA0H
        MOV      WR4,#07EH
        MOV      @DR4,R11                       ; A=R11
; line 34:     
; line 35:     // 4. 1T 模式（不分频，速度最快）
; line 36:     AUXR |= 0x80;              // T0x12 = 1
        ORL      AUXR,#080H
; line 37:     
; line 38:     // 5. 开中断
; line 39:     ET0 = 1;                   // 允许 T0 中断
        SETB     ET0
; line 40:     EA  = 1;                   // 开总中断
        SETB     ?EA
; line 41:     
; line 42:     // 6. 启动定时器
; line 43:     TR0 = 1;                   // T0 开始计数
        SETB     TR0
; line 44: }
        RET      
