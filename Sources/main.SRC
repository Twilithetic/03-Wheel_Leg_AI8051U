; line 25:     // 2. 设置重装载值（目标：10ms 中断）
; line 26:     //    系统时钟 = 24MHz (默认 HIRC)
; line 27:     //    TM0PS = 11 → 预分频 12 → 定时器时钟 = 2MHz
; line 28:     //    65536 - 20000 = 45536 = 0xB1E0
; line 29:     TL0 = 0xE0;                // 低字节先写
        MOV      TL0,#0E0H
; line 30:     TH0 = 0xB1;                // 高字节
